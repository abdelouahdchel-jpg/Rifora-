# ==============================================================================
# RIFORA VERCEL PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. OWNER IDENTITY
# The official store owner email address authorized to manage the store.
OWNER_EMAIL="abdelouahdchel@gmail.com"

# 2. STATELESS SESSION CRYPTOGRAPHIC SECRET (MANDATORY IN PRODUCTION)
# A private, random string (at least 32 characters) used to sign session cookies.
# Used across Vercel serverless function instances to verify authentication without in-memory state.
# Create privately (e.g., generate a 32-character random string).
SESSION_SECRET=""

# 3. FIRST-TIME OWNER SETUP SECRET (MANDATORY FOR INITIAL SETUP)
# A private secret passphrase that only you know. When you first visit /admin,
# you must enter this secret key to prove you own the Vercel deployment and unlock
# setting your permanent password. Once initialized, setup is locked permanently.
ADMIN_SETUP_SECRET=""

# 4. PERSISTENT POSTGRESQL DATABASE (VERCEL POSTGRES / NEON)
# Connection string for persistent database storage on Vercel.
# Automatically provided when you add "Vercel Postgres" in your Vercel project Storage tab,
# or paste your Neon / Supabase connection URI here.
POSTGRES_URL=""
# DATABASE_URL=""

# 5. PERSISTENT OBJECT STORAGE FOR PRODUCT IMAGES (VERCEL BLOB)
# Automatically provided when you add "Vercel Blob" in your Vercel project Storage tab.
# Enables CDN-backed, permanent storage for uploaded atelier photographs.
BLOB_READ_WRITE_TOKEN=""

# 6. LOCAL DEVELOPMENT PORT (AI Studio runtime)
PORT="3000"
